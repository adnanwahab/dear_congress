{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "policy-impact-preview.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "proposalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "versionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "type": {
          "enum": [
            "bill",
            "constitutional-amendment"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "visibility": {
          "const": "public"
        }
      },
      "required": [
        "system",
        "proposalId",
        "versionId",
        "contentHash",
        "type",
        "title",
        "url",
        "visibility"
      ]
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseVersionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "clauses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "clauseId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              },
              "sourcePolicyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "operation": {
                "enum": [
                  "add",
                  "remove",
                  "modify"
                ]
              },
              "beforeText": {
                "type": "string",
                "maxLength": 20000
              },
              "afterText": {
                "type": "string",
                "maxLength": 20000
              }
            },
            "required": [
              "clauseId",
              "sourcePolicyId",
              "operation",
              "beforeText",
              "afterText"
            ]
          }
        }
      },
      "required": [
        "baseVersionId",
        "clauses"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "current-law",
            "prior-proposal-version"
          ]
        },
        "versionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "versionId",
        "label"
      ]
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      },
      "required": [
        "seed",
        "runs",
        "months"
      ]
    },
    "modelRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "legal",
    "baseline",
    "simulation"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy-impact-preview.v1",
  "description": "Runtime validation additionally verifies canonical legal SHA256, unique IDs, operation/text consistency, baseline version equality, and credential/query/fragment-free HTTP source URL."
}

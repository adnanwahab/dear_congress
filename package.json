{
  "name": "civic-synthesis",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "purge:world": "bun scripts/purge-world-journals.ts",
    "outcomes:fetch": "bun scripts/fetch-outcomes.ts",
    "symphony:mini": "bun --no-env-file .mini-symphony/runner.js --config .mini-symphony/config.json",
    "symphony:mini:check": "bun --no-env-file .mini-symphony/runner.js --config .mini-symphony/config.json --check",
    "symphony:mini:sync": "bun --no-env-file .mini-symphony/import-linear.js --config .mini-symphony/config.json"
  },
  "dependencies": {
    "@deck.gl/core": "9.2",
    "@deck.gl/layers": "9.2",
    "@deck.gl/mapbox": "9.2",
    "maplibre-gl": "^6.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
